# ─────────────────────────────────────────────────────────────────────────────
# PIN GENERATOR PRO — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Pinterest API ─────────────────────────────────────────────────────────────
# Get from: https://developers.pinterest.com → My Apps → Create App
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Set this AFTER deploying to Vercel — use your actual Vercel URL
PINTEREST_REDIRECT_URI=https://YOUR-APP.vercel.app/api/auth/pinterest/callback

# ── Pexels API ────────────────────────────────────────────────────────────────
# Get from: https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Get from: https://huggingface.co/settings/tokens → New token (read)
HUGGINGFACE_API_KEY=

# ── Firebase (Public — safe to expose in frontend) ────────────────────────────
# Get from: Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (Private — server only, NEVER prefix with NEXT_PUBLIC_) ────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate key
# The downloaded JSON file contains these values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR KEY HERE\n-----END PRIVATE KEY-----\n"

# ── App Security ──────────────────────────────────────────────────────────────
# Any long random string — generate one at: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=

# Your deployed app URL (update after deploying)
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app

# ── Cron Security ─────────────────────────────────────────────────────────────
# Any long random string — must match the one in your Railway cron service
CRON_SECRET=
